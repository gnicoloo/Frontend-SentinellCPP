# Copia questo file in `.env.local` (o `.env`) e compila i valori.
#
# Il prefisso VITE_ NON è opzionale: Vite espone al bundle client solo le
# variabili che iniziano con VITE_. Senza prefisso, import.meta.env.VITE_*
# resta undefined e il client Supabase si crea con URL vuoto.
#
# Usa SEMPRE la anon key, mai la service-role key: questo file finisce nel
# bundle servito al browser, e la service-role key bypassa le policy RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
