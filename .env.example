# Copia questo file in `.env.local` (o `.env`) e compila i valori.
#
# Il prefisso VITE_ NON è opzionale: Vite espone al bundle client solo le
# variabili che iniziano con VITE_. Senza prefisso, import.meta.env.VITE_*
# resta undefined e il client Supabase si crea con URL vuoto.
#
# Usa SEMPRE la anon key, mai la service-role key: questo file finisce nel
# bundle servito al browser, e la service-role key bypassa le policy RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Strumenti CTF (opzionale) ------------------------------------------------
# Endpoint RPC Polygon usato dalla pagina /ctf per leggere saldi e stato delle
# condizioni. Lasciandolo vuoto si usa l'RPC pubblico di default, che funziona
# ma ha un rate limit basso: con più mercati in lista le letture iniziano a
# fallire in modo intermittente.
#
# Deve essere un endpoint che accetta chiamate dal browser: finisce nel bundle
# client, quindi non metterci una URL che contiene una API key privata -- per
# quelle serve un proxy lato server.
VITE_POLYGON_RPC_URL=
